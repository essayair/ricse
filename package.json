{
  "name": "ricse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n core,content,worker,web -c blue,cyan,magenta,green \"pnpm dev:api\" \"pnpm dev:content\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @ricse/api dev",
    "dev:content": "pnpm --filter @ricse/api dev:content",
    "dev:worker": "pnpm --filter @ricse/api dev:worker",
    "dev:web": "pnpm --filter @ricse/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ricse/api test",
    "db:generate": "pnpm --filter @ricse/api prisma:generate",
    "db:migrate": "pnpm --filter @ricse/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @ricse/api prisma:migrate:deploy",
    "db:studio": "pnpm --filter @ricse/api prisma:studio",
    "db:seed": "pnpm --filter @ricse/api prisma:seed",
    "db:seed:blank": "pnpm --filter @ricse/api prisma:seed:blank",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "pnpm install && pnpm docker:up && pnpm db:migrate && pnpm db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver",
      "bcryptjs",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
