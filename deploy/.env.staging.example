# 复制为 deploy/.env.staging 后填写。不要提交真实密钥。
COMPOSE_PROJECT_NAME=ricse-staging

# 云效流水线发布时使用 ACR 私有镜像；手工源码部署可保留默认值。
API_IMAGE=ricse-staging-api
WEB_IMAGE=ricse-staging-web
IMAGE_TAG=local

# 首次仅限可信 IP 验证时可使用 HTTP；对外测试请改成 HTTPS 配置。
PUBLIC_HOST=YOUR_ECS_IP_OR_DOMAIN
PUBLIC_URL=http://YOUR_ECS_IP_OR_DOMAIN
MINIO_PUBLIC_PORT=80
MINIO_PUBLIC_USE_SSL=false
ENABLE_HTTPS=false

POSTGRES_DB=ricse_staging
POSTGRES_USER=ricse
# 建议使用至少 24 位、仅包含 URL 安全字符的随机密码。
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=24h
ALLOW_PUBLIC_REGISTRATION=false

# 仅在首次使用 deploy.sh --seed 初始化测试数据时使用。
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_APPROVER_PASSWORD=CHANGE_ME_APPROVER_PASSWORD
SEED_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

MINIO_ROOT_USER=ricse_staging
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=ricse-attachments
# MinIO 默认区域；API 生成公网预签名地址时使用，避免查询公网 DNS。
MINIO_REGION=us-east-1

# 内容运营中心：第三方凭据只配置在服务器/云效变量中，禁止提交真实值。
CONTENT_CORS_ORIGIN=https://YOUR_WEBSITE_DOMAIN,https://YOUR_MINIAPP_H5_DOMAIN
WECHAT_TOKEN_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
BAIINFO_AUTH=
BAIINFO_COOKIE=
BAIINFO_USERNAME=
BAIINFO_PASSWORD=
MARKET_SYNC_CRON=0 6 * * *
NEWS_SYNC_CRON=0 5 * * *
CONTENT_TIMEZONE=Asia/Shanghai
GDELT_FALLBACK_DELAY_MS=10500
# 逗号分隔，仅填写经业务与运维确认的 RSS/Atom 域名。
NEWS_SOURCE_ALLOWED_HOSTS=
CONTENT_SYNC_ON_STARTUP=true
CONTENT_WORKER_CONCURRENCY=1
CONTENT_API_MEMORY_LIMIT=512m
CONTENT_WORKER_MEMORY_LIMIT=768m
