# 复制为 deploy/.env.staging 后填写。不要提交真实密钥。
COMPOSE_PROJECT_NAME=ricse-staging

# 云效流水线发布时使用 ACR 私有镜像；手工源码部署可保留默认值。
API_IMAGE=ricse-staging-api
WEB_IMAGE=ricse-staging-web
IMAGE_TAG=local

# 首次仅限可信 IP 验证时可使用 HTTP；对外测试请改成 HTTPS 配置。
PUBLIC_HOST=YOUR_ECS_IP_OR_DOMAIN
PUBLIC_URL=http://YOUR_ECS_IP_OR_DOMAIN
MINIO_PUBLIC_PORT=80
MINIO_PUBLIC_USE_SSL=false

POSTGRES_DB=ricse_staging
POSTGRES_USER=ricse
# 建议使用至少 24 位、仅包含 URL 安全字符的随机密码。
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=24h
ALLOW_PUBLIC_REGISTRATION=false

# 仅在首次使用 deploy.sh --seed 初始化测试数据时使用。
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_APPROVER_PASSWORD=CHANGE_ME_APPROVER_PASSWORD
SEED_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

MINIO_ROOT_USER=ricse_staging
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=ricse-attachments
