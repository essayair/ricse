server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 301 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 100m;

    location ^~ /api/v1/content/ {
        proxy_pass http://content-api:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/v1/public/ {
        proxy_pass http://content-api:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }

    location = /api/v1/content-health {
        proxy_pass http://content-api:3002;
    }

    location ^~ /api/content-docs {
        proxy_pass http://content-api:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }


    # 已发布旧版官网/小程序兼容入口；迁移观察期结束后删除。
    location /api/news/ {
        rewrite ^/api/news/(.*)$ /api/v1/legacy/news/$1 break;
        proxy_pass http://content-api:3002;
    }
    location /api/market/baiinfo/fluorite/ {
        rewrite ^/api/market/baiinfo/fluorite/(.*)$ /api/v1/public/content/market/fluorite/$1 break;
        proxy_pass http://content-api:3002;
    }
    location /api/ai/ {
        rewrite ^/api/ai/(.*)$ /api/v1/public/ai/$1 break;
        proxy_pass http://content-api:3002;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = /api/auth/wx-login {
        proxy_pass http://content-api:3002/api/v1/legacy/auth/wx-login;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /api/supply-demand/ {
        rewrite ^/api/supply-demand/(.*)$ /api/v1/legacy/supply-demand/$1 break;
        proxy_pass http://content-api:3002;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = /app-api/website/industry-news/page { proxy_pass http://content-api:3002/api/v1/legacy/website/industry-news/page; add_header X-RICSE-Compatibility true always; }
    location = /app-api/website/industry-news/get { proxy_pass http://content-api:3002/api/v1/legacy/website/industry-news/get; add_header X-RICSE-Compatibility true always; }
    location = /app-api/website/price/list { proxy_pass http://content-api:3002/api/v1/legacy/website/price/list; }
    location = /app-api/website/contact/create {
        proxy_pass http://content-api:3002/api/v1/legacy/website/contact/create;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ricse-attachments/ {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://web:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
