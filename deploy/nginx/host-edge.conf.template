server {
    listen 80;
    server_name __PUBLIC_HOST__;
    return 301 https://__PUBLIC_HOST__$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __PUBLIC_HOST__;

    ssl_certificate /opt/ricse/deploy/certs/fullchain.pem;
    ssl_certificate_key /opt/ricse/deploy/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RICSE_SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 100m;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name __PUBLIC_HOST__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
