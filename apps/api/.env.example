DATABASE_URL=postgresql://ricse:ricse_dev@localhost:5433/ricse_dev?schema=public
REDIS_URL=redis://localhost:6380

MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9002
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=ricse
MINIO_SECRET_KEY=ricse_dev
MINIO_BUCKET=ricse-attachments

JWT_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-development-secret
JWT_EXPIRES_IN=24h
ALLOW_PUBLIC_REGISTRATION=true

CORS_ORIGIN=http://localhost:3001
CONTENT_API_PORT=3002
CONTENT_CORS_ORIGIN=http://localhost:3001,http://localhost:5000

# 内容运营中心第三方能力；真实值仅放本机 .env 或部署密钥变量。
WECHAT_TOKEN_SECRET=replace-with-the-legacy-auth-token-secret-during-compatibility
WX_APPID=
WX_SECRET=
# 小程序任务提醒模板：待审批通知、工作任务待办通知。
# 审批模板字段：thing2（审批类型）、time3（发送时间）、thing4（备注）
WX_SUBSCRIBE_APPROVAL_TEMPLATE_ID=
# 任务模板字段：thing1（待办类型）、thing2（待办内容）、time3（时间）
WX_SUBSCRIBE_TASK_TEMPLATE_ID=
# developer | trial | formal
WX_MINIPROGRAM_STATE=developer
DEEPSEEK_API_KEY=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
BAIINFO_AUTH=
BAIINFO_COOKIE=
BAIINFO_USERNAME=
BAIINFO_PASSWORD=
MARKET_SYNC_CRON=0 6 * * *
NEWS_SYNC_CRON=0 8,12,17 * * *
CONTENT_TIMEZONE=Asia/Shanghai
GDELT_FALLBACK_DELAY_MS=10500
# 逗号分隔，仅填写已获准订阅的 RSS/Atom 域名，例如 news.example.com,feeds.example.org
NEWS_SOURCE_ALLOWED_HOSTS=
CONTENT_SYNC_ON_STARTUP=true
CONTENT_WORKER_CONCURRENCY=1
NODE_ENV=development
PORT=3000
