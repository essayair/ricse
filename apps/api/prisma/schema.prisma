generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 认证&用户 ==========

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  name            String
  role            String   @default("USER") // USER | ADMIN | APPROVER
  phone           String?
  email           String?
  status          String   @default("ACTIVE") // ACTIVE | DISABLED
  refreshToken    String?
  companyId       String?  // 所属企业
  businessGroupId String?  // 所属业务组
  employeeId      String?  @unique // 关联员工档案（一对一）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  createdContracts Contract[]      @relation("ContractCreator")
  createdPartners  Partner[]       @relation("PartnerCreator")
  approvalTasks    Approval[]      @relation("ApprovalAssignee")

  @@map("users")
}

// ========== 组织架构 ==========

/// 企业主体（内部企业 + 外部企业）
model Company {
  id        String   @id @default(cuid())
  code      String   @unique // 6位(内部) 或 8位(外部)
  name      String
  shortName String?
  type      String   @default("INTERNAL") // INTERNAL | EXTERNAL
  partnerId String?  // 外部企业关联合作伙伴
  parentId  String?  // 上级企业（组织树）
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Company?       @relation("CompanyTree", fields: [parentId], references: [id])
  children   Company[]      @relation("CompanyTree")
  partner    Partner?       @relation("CompanyPartner", fields: [partnerId], references: [id])
  departments Department[]
  employees   Employee[]
  users       User[]
  contracts   Contract[]
  bgMappings  BusinessGroupCompany[]

  @@map("companies")
}

/// 部门
model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  parentId  String?  // 上级部门
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  employees Employee[]

  @@index([companyId])
  @@map("departments")
}

/// 员工
model Employee {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  companyId    String
  position     String?  // 岗位
  phone        String?
  email        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?

  @@index([companyId])
  @@index([departmentId])
  @@map("employees")
}

/// 业务组
model BusinessGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies BusinessGroupCompany[]

  @@map("business_groups")
}

/// 业务组 ↔ 企业 多对多
model BusinessGroupCompany {
  businessGroupId String
  companyId       String

  businessGroup BusinessGroup @relation(fields: [businessGroupId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])

  @@id([businessGroupId, companyId])
  @@map("business_group_companies")
}

// ========== 主数据 ==========

/// 合作伙伴（BP）
/// code 规则：内部企业 6 位字母数字 / 外部企业 8 位纯数字
/// 唯一校验：统一信用代码 + 企业名称联合唯一
model Partner {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  shortName     String?
  shortCode     String?   // 拼音简码，用于快速搜索
  taxId         String?   // 统一社会信用代码
  orgType       String?   // 组织性质：有限责任公司/股份有限公司/国有企业/外资企业/个体工商户
  category      String?   // 合作伙伴类别：CORE/NORMAL/TEMP
  legalPerson   String?
  legalIdCard   String?   // 法人身份证号
  controller    String?   // 实际控制人
  controllerPhone String? // 实控人联系方式
  contactPerson String?
  contactPhone  String?
  province      String?
  city          String?
  address       String?
  bizAddress    String?
  sourceRegion  String?
  estDate       DateTime? // 成立日期
  regCapital    Decimal?  @db.Decimal(15, 2) // 注册资本（万）
  taxType       String?   // 纳税人类型：GENERAL/SMALL_SCALE/EXEMPT
  taxRating     String?   // 纳税评级：A/B/C/D
  invoiceType   String?   // 发票类型
  industry      String?   // 行业
  corpType      String?   // 企业类型：PRODUCTION/TRADE/SERVICE
  bizScope      String?   // 经营范围
  tradingGoods  String?   // 拟交易品种
  creditLimit      Decimal?  @db.Decimal(15, 2)
  // 内部 / 外部标识（独立于角色，决定编码规则：内部6位字母数字，外部8位数字）
  isInternal       Boolean   @default(false)
  // 额外字段（来自原型）
  country          String?   // 国家/地区，默认中国大陆
  legalPersonType  String?   // 法人类型：自然人/法人
  controllerTitle  String?   // 实际控制人职务
  regNo            String?   // 注册登记号
  regCurrency      String?   // 注册资本货币：人民币/美元/欧元
  revenueScale     String?   // 营业收入规模
  groupName        String?   // 所属集团
  isParent         Boolean?  // 本身为母公司
  relatedPartyType String?   // 是否为关联方
  licenseType      String?   // 特殊证照：采矿许可证/危化品/道路运输/无
  licenseExpiry    DateTime? // 资质到期日
  mainBiz          String?   // 主营业务及品种
  equityStructure  String?   // 股权结构
  intro            String?   // 企业介绍
  roles            String[]  // SUPPLIER | CUSTOMER（角色：合作伙伴只有供应商和客户）
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLIST
  remark           String?
  createdBy        String?   // 创建人
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  creator            User?         @relation("PartnerCreator", fields: [createdBy], references: [id])
  attachments        Attachment[]
  companies          Company[]       @relation("CompanyPartner")
  contractsAsSeller  Contract[]      @relation("ContractSeller")
  contractsAsBuyer    Contract[]      @relation("ContractBuyer")
  vehicles            Vehicle[]
  bankAccounts        BankAccount[]
  warehouses          Warehouse[]

  @@unique([taxId, name])
  @@map("partners")
}

model MaterialCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    MaterialCategory? @relation("CategoryParent", fields: [parentId], references: [id])
  children  MaterialCategory[] @relation("CategoryParent")
  materials Material[]

  @@map("material_categories")
}

model Material {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  categoryId   String
  grade        String?  // 品级：CaF₂≥97%、CaF₂≥95% 等（保留兼容）
  unit         String   @default("TON")
  spec         String?
  sourceRegion String?
  packageType  String?  // 包装方式：散装 / 吨袋 / 小包装
  isVirtual    Boolean  @default(false)  // 是否虚拟物料
  specs        Json?    // 规格指标数组 [{name,indicator,operator,value,unit}]
  hsCode       String?  // HS编码（海关报关）
  taxCode      String?  // 税务商品编码
  internalCode String?  // 内部编码
  qcTemplate   String?  // 质检模板ID
  status       String   @default("ACTIVE")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  category MaterialCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("materials")
}

/// 车辆管理
model Vehicle {
  id           String   @id @default(cuid())
  plateNo      String   @unique
  vehicleType  String   // TRUCK | TANK | TRAILER
  brand        String?
  loadCapacity Decimal  @db.Decimal(10, 2)
  ownerId      String?  // 关联 Partner（外协车辆）
  ownerType    String   @default("SELF") // SELF | OUTSOURCED
  driverName   String?
  driverPhone  String?
  status       String   @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  owner Partner? @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("vehicles")
}

/// 银行账户
model BankAccount {
  id          String  @id @default(cuid())
  partnerId   String
  accountName String
  accountNo   String
  bankName    String
  bankCode    String?
  accountType String  @default("GENERAL") // BASIC | GENERAL
  currency    String  @default("CNY")
  isDefault   Boolean @default(false)
  status      String  @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("bank_accounts")
}

/// 仓库
model Warehouse {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String   @default("SELF") // SELF（自有）| RENT（租赁）
  partnerId    String?  // 关联 Partner（租赁方或所属方）
  address      String?
  manager      String?
  managerPhone String?
  status       String   @default("ACTIVE")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("warehouses")
}

// ========== 合约模块 ==========

model Contract {
  id                String         @id @default(cuid())
  contractNo        String         @unique
  title             String
  type              String         // PURCHASE | SALES | BILATERAL
  status            String         @default("DRAFT") // DRAFT|PENDING_APPROVAL|APPROVED|REJECTED|EXECUTING|COMPLETED|CLOSED|VOIDED
  sellerId          String         // 卖方（必填）
  buyerId           String?
  // 我方信息
  companyId         String?        // 签约主体（内部企业）
  departmentId      String?        // 业务部门
  externalNo        String?        // 外部合同号
  // 对手方
  contactPerson     String?        // 对手方联系人
  contactPhone      String?        // 对手方电话
  // 货物与价格
  pricingType       String?        // 定价类型：FIXED/BASIS/FLOATING
  overfillPct       Decimal?       @db.Decimal(5, 2)  // 溢装比例(%)
  shortfallPct      Decimal?       @db.Decimal(5, 2)  // 短装比例(%)
  // 履约
  deliveryMethod    String?        // 交货方式
  deliveryLocation  String?        // 收货/发货地点
  totalAmount       Decimal        @db.Decimal(15, 2)
  signedAt          DateTime?
  effectiveAt       DateTime?
  expireAt          DateTime?
  // 结算
  settlementMethod  String         @default("DELIVERY")
  settlementBasis   String?        // 结算数量依据：WEIGHT/QUALITY/CONTRACT
  prepayPct         Decimal?       @db.Decimal(5, 2)  // 预付比例(%)
  paymentDays       Int?           // 尾款账期（天）
  paymentMethod     String?        // 付款方式
  moistureRule      String?        // 扣水规则
  impurityRule      String?        // 扣杂规则
  remarks           String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  lineItems   ContractLineItem[]
  approvals   Approval[]
  attachments Attachment[]
  creator     User     @relation("ContractCreator", fields: [createdBy], references: [id])
  seller      Partner  @relation("ContractSeller", fields: [sellerId], references: [id])
  buyer       Partner? @relation("ContractBuyer", fields: [buyerId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([contractNo])
  @@index([status])
  @@index([sellerId])
  @@map("contracts")
}

model ContractLineItem {
  id          String   @id @default(cuid())
  contractId  String
  materialId  String
  materialName String?
  quantity    Decimal  @db.Decimal(15, 3)
  unit        String   @default("TON")
  unitPrice   Decimal  @db.Decimal(15, 4)
  totalPrice  Decimal  @db.Decimal(15, 2)
  deliveryDate DateTime?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_line_items")
}

model Approval {
  id          String   @id @default(cuid())
  contractId  String
  assigneeId  String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  assignee User     @relation("ApprovalAssignee", fields: [assigneeId], references: [id])

  @@index([contractId])
  @@index([assigneeId])
  @@map("approvals")
}

/// 附件/影像
model Attachment {
  id           String   @id @default(cuid())
  partnerId    String?  // 关联合作伙伴
  contractId   String?  // 关联合同
  fileName     String   // 存储文件名（UUID）
  originalName String   // 原始文件名
  mimeType     String
  size         Int      // 字节
  category     String   // 附件类别
  createdAt    DateTime @default(now())

  partner  Partner?  @relation(fields: [partnerId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([partnerId])
  @@index([contractId])
  @@map("attachments")
}
