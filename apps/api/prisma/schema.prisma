generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 认证&用户 ==========

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  name            String
  role            String   @default("USER") // USER | ADMIN | APPROVER
  phone           String?
  email           String?
  status          String   @default("ACTIVE") // ACTIVE | DISABLED
  refreshToken    String?
  companyId       String? // 所属企业
  businessGroupId String? // 所属业务组
  employeeId      String?  @unique // 关联员工档案（一对一）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company                      Company?                 @relation(fields: [companyId], references: [id])
  employee                     Employee?                @relation(fields: [employeeId], references: [id])
  roleAssignments              UserRoleAssignment[]
  createdContracts             Contract[]               @relation("ContractCreator")
  createdPartners              Partner[]                @relation("PartnerCreator")
  approvalTasks                Approval[]               @relation("ApprovalAssignee")
  actedApprovals               Approval[]               @relation("ApprovalActor")
  createdOrders                Order[]                  @relation("OrderCreator")
  createdDispatchNotices       DispatchNotice[]         @relation("DispatchNoticeCreator")
  createdWaybills              Waybill[]                @relation("WaybillCreator")
  createdWeighTickets          WeighTicket[]            @relation("WeighTicketCreator")
  reviewedWeighTickets         WeighTicket[]            @relation("WeighTicketReviewer")
  weighTicketSelections        WaybillWeightSelection[] @relation("WaybillWeightSelector")
  weighRecords                 WeighRecord[]            @relation("WeighRecordOperator")
  createdQualityInspections    QualityInspection[]      @relation("QualityInspectionCreator")
  confirmedQualityInspections  QualityInspection[]      @relation("QualityInspectionConfirmer")
  createdQualityTasks          QualityTask[]            @relation("QualityTaskCreator")
  handledQualityTasks          QualityTask[]            @relation("QualityTaskHandler")
  decidedQualityTasks          QualityTask[]            @relation("QualityTaskDecider")
  createdInboundReceipts       InboundReceipt[]         @relation("InboundReceiptCreator")
  createdBusinessInbounds      BusinessInbound[]        @relation("BusinessInboundCreator")
  createdOutboundOrders        OutboundOrder[]          @relation("OutboundOrderCreator")
  createdOutboundReceipts      OutboundReceipt[]        @relation("OutboundReceiptCreator")
  createdSalesOutbounds        SalesOutbound[]          @relation("SalesOutboundCreator")
  inventoryLedgerEntries       InventoryLedger[]        @relation("InventoryLedgerCreator")
  createdInventoryReversals    InventoryReversal[]      @relation("InventoryReversalCreator")
  approvedInventoryReversals   InventoryReversal[]      @relation("InventoryReversalApprover")
  postedInventoryReversals     InventoryReversal[]      @relation("InventoryReversalPoster")
  createdProductionRecipes     ProductionRecipe[]       @relation("ProductionRecipeCreator")
  createdProductionTasks       ProductionTask[]         @relation("ProductionTaskCreator")
  createdProductionCompletions ProductionCompletion[]   @relation("ProductionCompletionCreator")
  qualityConfirmedCompletions  ProductionCompletion[]   @relation("ProductionCompletionQualityConfirmer")
  postedProductionCompletions  ProductionCompletion[]   @relation("ProductionCompletionPoster")

  @@map("users")
}

// ========== 组织架构 ==========

/// 企业主体（内部企业 + 外部企业）
model Company {
  id        String   @id @default(cuid())
  code      String   @unique // 6位(内部) 或 8位(外部)
  name      String
  shortName String?
  type      String   @default("INTERNAL") // INTERNAL | EXTERNAL
  partnerId String? // 外部企业关联合作伙伴
  parentId  String? // 上级企业（组织树）
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      Company?               @relation("CompanyTree", fields: [parentId], references: [id])
  children    Company[]              @relation("CompanyTree")
  partner     Partner?               @relation("CompanyPartner", fields: [partnerId], references: [id])
  departments Department[]
  employees   Employee[]
  users       User[]
  contracts   Contract[]
  bgMappings  BusinessGroupCompany[]

  @@map("companies")
}

/// 部门
model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  parentId  String? // 上级部门
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]

  @@index([companyId])
  @@map("departments")
}

/// 员工
model Employee {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  companyId    String
  position     String? // 岗位
  phone        String?  @unique // 11位中国大陆登录手机号；新建员工必填，历史数据可为空
  email        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?

  @@index([companyId])
  @@index([departmentId])
  @@map("employees")
}

/// 业务组
model BusinessGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies BusinessGroupCompany[]

  @@map("business_groups")
}

/// 业务组 ↔ 企业 多对多
model BusinessGroupCompany {
  businessGroupId String
  companyId       String

  businessGroup BusinessGroup @relation(fields: [businessGroupId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])

  @@id([businessGroupId, companyId])
  @@map("business_group_companies")
}

// ========== 角色、权限与数据范围 ==========

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  type        String   @default("BUSINESS") // SYSTEM | MANAGEMENT | BUSINESS
  status      String   @default("ACTIVE")
  isSystem    Boolean  @default(false)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions       RolePermission[]
  assignments       UserRoleAssignment[]
  approvalFlowNodes ApprovalFlowNode[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // resource.action
  name        String
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  scopeType   String    @default("ALL") // SELF | DEPARTMENT | DEPARTMENT_AND_CHILDREN | COMPANY | SPECIFIED_COMPANIES | ALL
  status      String    @default("ACTIVE")
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  assignedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopes UserRoleScope[]

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model UserRoleScope {
  id           String   @id @default(cuid())
  assignmentId String
  targetType   String // COMPANY | DEPARTMENT | WAREHOUSE
  targetId     String
  createdAt    DateTime @default(now())

  assignment UserRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("user_role_scopes")
}

// ========== 主数据 ==========

/// 合作伙伴（BP）
/// code 规则：内部企业 6 位字母数字 / 外部企业 8 位纯数字
/// 唯一校验：统一信用代码 + 企业名称联合唯一
model Partner {
  id               String    @id @default(cuid())
  code             String
  name             String
  shortName        String?
  shortCode        String? // 拼音简码，用于快速搜索
  taxId            String? // 统一社会信用代码
  orgType          String? // 组织性质：有限责任公司/股份有限公司/国有企业/外资企业/个体工商户
  category         String? // 合作伙伴类别：CORE/NORMAL/TEMP
  legalPerson      String?
  legalIdCard      String? // 法人身份证号
  controller       String? // 实际控制人
  controllerPhone  String? // 实控人联系方式
  contactPerson    String?
  contactPhone     String?
  province         String?
  city             String?
  address          String?
  bizAddress       String?
  sourceRegion     String?
  estDate          DateTime? // 成立日期
  regCapital       Decimal?  @db.Decimal(15, 2) // 注册资本（万）
  taxType          String? // 纳税人类型：GENERAL/SMALL_SCALE/EXEMPT
  taxRating        String? // 纳税评级：A/B/C/D
  invoiceType      String? // 发票类型
  industry         String? // 行业
  corpType         String? // 企业类型：PRODUCTION/TRADE/SERVICE
  bizScope         String? // 经营范围
  tradingGoods     String? // 拟交易品种
  creditLimit      Decimal?  @db.Decimal(15, 2)
  // 内部 / 外部标识（独立于角色，决定编码规则：内部6位字母数字，外部8位数字）
  isInternal       Boolean   @default(false)
  // 额外字段（来自原型）
  country          String? // 国家/地区，默认中国大陆
  legalPersonType  String? // 法人类型：自然人/法人
  controllerTitle  String? // 实际控制人职务
  regNo            String? // 注册登记号
  regCurrency      String? // 注册资本货币：人民币/美元/欧元
  revenueScale     String? // 营业收入规模
  groupName        String? // 所属集团
  isParent         Boolean? // 本身为母公司
  relatedPartyType String? // 是否为关联方
  licenseType      String? // 特殊证照：采矿许可证/危化品/道路运输/无
  licenseExpiry    DateTime? // 资质到期日
  mainBiz          String? // 主营业务及品种
  equityStructure  String? // 股权结构
  intro            String? // 企业介绍
  roles            String[] // SUPPLIER | CUSTOMER（角色：合作伙伴只有供应商和客户）
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLIST
  remark           String?
  createdBy        String? // 创建人
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  creator                 User?                 @relation("PartnerCreator", fields: [createdBy], references: [id])
  attachments             Attachment[]
  companies               Company[]             @relation("CompanyPartner")
  contractsAsSeller       Contract[]            @relation("ContractSeller")
  contractsAsBuyer        Contract[]            @relation("ContractBuyer")
  contractsAsSigningParty Contract[]            @relation("ContractSigningPartner")
  vehicles                Vehicle[]
  bankAccounts            BankAccount[]
  warehouses              Warehouse[]
  serviceOrganizations    ServiceOrganization[]
  carrierWaybills         Waybill[]             @relation("WaybillCarrierPartner")
  institutionInspections  QualityInspection[]   @relation("QualityInstitutionPartner")
  ownedBusinessInbounds   BusinessInbound[]     @relation("BusinessInboundOwner")
  ownedInventoryLots      InventoryLot[]        @relation("InventoryLotOwner")
  ownedOutboundOrders     OutboundOrder[]       @relation("OutboundOrderOwner")
  ownedProductionRecipes  ProductionRecipe[]    @relation("ProductionRecipeOwner")
  ownedProductionTasks    ProductionTask[]      @relation("ProductionTaskOwner")

  @@unique([taxId, name])
  @@map("partners")
}

/// 合作伙伴服务生态档案
/// 一个合作伙伴可分别维护物流承运、质检、仓储与港口、加工服务四类专业档案
model ServiceOrganization {
  id                 String    @id @default(cuid())
  code               String    @unique
  partnerId          String
  organizationType   String // LOGISTICS_CARRIER | QUALITY_INSTITUTION | WAREHOUSE_PORT | PROCESSING_PROVIDER
  licenseNo          String?
  licenseExpiry      DateTime?
  qualificationNo    String?
  cmaNo              String?
  cnasNo             String?
  serviceScope       String?
  serviceRegions     String?
  transportModes     String[]
  cargoTypes         String?
  supportedMaterials String?
  supportedItems     String?
  operationType      String? // WAREHOUSE | PORT | WAREHOUSE_PORT
  storageCapacity    Decimal?  @db.Decimal(15, 3)
  dispatcherName     String?
  dispatcherPhone    String?
  contactPerson      String?
  contactPhone       String?
  settlementMethod   String?
  reportCycleDays    Int?
  insuranceInfo      String?
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLIST
  remark             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  partner         Partner          @relation(fields: [partnerId], references: [id])
  drivers         Driver[]
  productionTasks ProductionTask[]

  @@unique([partnerId, organizationType])
  @@index([organizationType, status])
  @@index([partnerId])
  @@map("service_organizations")
}

/// 司机档案；归属于物流承运商服务档案
model Driver {
  id                    String    @id @default(cuid())
  serviceOrganizationId String
  name                  String
  phone                 String
  idCardNo              String?
  licenseNo             String?
  licenseClass          String?
  licenseExpiry         DateTime?
  status                String    @default("ACTIVE") // ACTIVE | INACTIVE
  remark                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  serviceOrganization ServiceOrganization @relation(fields: [serviceOrganizationId], references: [id])
  waybills            Waybill[]
  vehicleLinks        VehicleDriver[]

  @@unique([serviceOrganizationId, phone])
  @@index([serviceOrganizationId, status])
  @@index([name])
  @@index([phone])
  @@map("drivers")
}

model MaterialCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent              MaterialCategory?   @relation("CategoryParent", fields: [parentId], references: [id])
  children            MaterialCategory[]  @relation("CategoryParent")
  materials           Material[]
  standardCommodities StandardCommodity[]

  @@map("material_categories")
}

model StandardCommodity {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  categoryId       String
  baseName         String
  commodityForm    String
  coreSpecName     String
  coreSpecOperator String
  coreSpecValue    String
  coreSpecUnit     String
  packageType      String
  unit             String   @default("TON")
  fingerprint      String   @unique
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category  MaterialCategory @relation(fields: [categoryId], references: [id])
  materials Material[]

  @@index([categoryId])
  @@index([status])
  @@map("standard_commodities")
}

model Material {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  categoryId          String
  standardCommodityId String?
  referenceType       String    @default("TRADING_GOODS")
  commodityForm       String?
  grade               String? // 品级：CaF₂≥97%、CaF₂≥95% 等（保留兼容）
  unit                String    @default("TON")
  spec                String?
  sourceRegion        String?
  packageType         String? // 包装方式：散装 / 吨袋 / 小包装
  isVirtual           Boolean   @default(false) // 是否虚拟物料
  specs               Json? // 规格指标数组 [{name,indicator,operator,value,unit}]
  hsCode              String? // HS编码（海关报关）
  taxCode             String? // 税务商品编码
  internalCode        String? // 内部编码
  qcTemplate          String? // 质检模板ID
  status              String    @default("ACTIVE")
  remark              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  category                MaterialCategory        @relation(fields: [categoryId], references: [id])
  standardCommodity       StandardCommodity?      @relation(fields: [standardCommodityId], references: [id])
  businessInbounds        BusinessInbound[]
  salesOutbounds          SalesOutbound[]
  inventoryLots           InventoryLot[]
  inventoryLedgers        InventoryLedger[]
  OutboundReceipt         OutboundReceipt[]
  productionRecipeInputs  ProductionRecipeInput[]
  productionRecipeOutputs ProductionRecipe[]      @relation("ProductionRecipeOutputMaterial")
  productionTaskInputs    ProductionTaskInput[]
  productionTaskOutputs   ProductionTask[]        @relation("ProductionTaskOutputMaterial")
  productionCompletions   ProductionCompletion[]

  @@index([categoryId])
  @@index([standardCommodityId])
  @@index([referenceType])
  @@map("materials")
}

/// 车辆管理
model Vehicle {
  id                        String    @id @default(cuid())
  plateNo                   String    @unique
  vehicleType               String // SEMI_TRAILER | HEAVY_SEMI_TRAILER | BOX_TRUCK | DUMP_TRUCK | TANK_TRUCK；兼容 TRUCK/TANK/TRAILER
  brand                     String?
  tareWeight                Decimal?  @db.Decimal(10, 2)
  loadCapacity              Decimal   @db.Decimal(10, 2)
  plateColor                String? // YELLOW | GREEN | BLUE | BLACK | OTHER
  licenseNo                 String?
  annualInspectionExpiry    DateTime?
  compulsoryInsuranceExpiry DateTime?
  commercialInsuranceExpiry DateTime?
  ownerId                   String? // 关联 Partner
  ownerType                 String    @default("SELF") // SELF | OUTSOURCED
  ownerName                 String?
  ownerPhone                String?
  driverName                String? // 兼容旧数据；新数据取主驾快照
  driverPhone               String? // 兼容旧数据；新数据取主驾快照
  deviceType                String? // BEIDOU | GPS | NONE
  deviceNo                  String?
  deviceInstalledAt         DateTime?
  status                    String    @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  remark                    String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  owner    Partner?        @relation(fields: [ownerId], references: [id])
  drivers  VehicleDriver[]
  waybills Waybill[]

  @@index([ownerId])
  @@map("vehicles")
}

/// 车辆与司机关联；一辆车可关联多名主/副驾，司机仍保持独立主数据身份
model VehicleDriver {
  id        String   @id @default(cuid())
  vehicleId String
  driverId  String
  role      String   @default("SECONDARY") // PRIMARY | SECONDARY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, driverId])
  @@index([driverId])
  @@map("vehicle_drivers")
}

/// 银行账户
model BankAccount {
  id          String   @id @default(cuid())
  partnerId   String
  accountName String
  accountNo   String
  bankName    String
  bankCode    String?
  accountType String   @default("GENERAL") // BASIC | GENERAL
  currency    String   @default("CNY")
  isDefault   Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("bank_accounts")
}

/// 仓库
model Warehouse {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  type         String    @default("SELF") // SELF（自有）| RENT（租赁）
  partnerId    String? // 关联 Partner（租赁方或所属方）
  address      String?
  manager      String?
  managerPhone String?
  status       String    @default("ACTIVE")
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  partner               Partner?          @relation(fields: [partnerId], references: [id])
  dispatchNotices       DispatchNotice[]
  inboundReceipts       InboundReceipt[]
  businessInbounds      BusinessInbound[]
  outboundReceipts      OutboundReceipt[]
  outboundOrders        OutboundOrder[]
  salesOutbounds        SalesOutbound[]
  inventoryLots         InventoryLot[]
  inventoryLedgers      InventoryLedger[]
  productionSourceTasks ProductionTask[]  @relation("ProductionTaskSourceWarehouse")
  productionTargetTasks ProductionTask[]  @relation("ProductionTaskTargetWarehouse")

  @@index([partnerId])
  @@map("warehouses")
}

// ========== 合约模块 ==========

model Contract {
  id               String    @id @default(cuid())
  contractNo       String    @unique
  clientRequestId  String? // 新建页面请求标识，用于防止网络重试产生重复草稿
  title            String
  type             String // PURCHASE | SALES | BILATERAL
  status           String    @default("DRAFT") // DRAFT|PENDING_APPROVAL|APPROVED|REJECTED|EXECUTING|COMPLETED|CLOSED|VOIDED
  sellerId         String // 卖方（必填）
  buyerId          String?
  // 我方信息
  signingPartnerId String? // 我方签约主体（内部合作伙伴）
  companyId        String? // 签约主体（内部企业）
  departmentId     String? // 业务部门
  externalNo       String? // 外部合同号：纸质合同或其他系统合同编号
  // 对手方
  contactPerson    String? // 对手方联系人
  contactPhone     String? // 对手方电话
  // 货物与价格
  pricingType      String? // 定价类型：FIXED/BASIS/FLOATING
  overfillPct      Decimal?  @default(10) @db.Decimal(5, 2) // 溢装比例(%)，默认10%
  shortfallPct     Decimal?  @default(10) @db.Decimal(5, 2) // 短装比例(%)，默认10%
  // 履约
  deliveryMethod   String? // 交货方式
  deliveryLocation String? // 收货/发货地点
  totalAmount      Decimal   @db.Decimal(15, 2)
  signedAt         DateTime?
  effectiveAt      DateTime?
  expireAt         DateTime?
  // 结算
  settlementMethod String    @default("DELIVERY")
  settlementBasis  String? // 结算数量依据：WEIGHT/QUALITY/CONTRACT
  prepayPct        Decimal?  @db.Decimal(5, 2) // 预付比例(%)
  paymentDays      Int? // 尾款账期（天）
  paymentMethod    String? // 付款方式
  moistureRule     String? // 扣水规则
  impurityRule     String? // 扣杂规则
  remarks          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  lineItems      ContractLineItem[]
  approvals      Approval[]
  attachments    Attachment[]
  creator        User               @relation("ContractCreator", fields: [createdBy], references: [id])
  seller         Partner            @relation("ContractSeller", fields: [sellerId], references: [id])
  buyer          Partner?           @relation("ContractBuyer", fields: [buyerId], references: [id])
  signingPartner Partner?           @relation("ContractSigningPartner", fields: [signingPartnerId], references: [id])
  company        Company?           @relation(fields: [companyId], references: [id])
  orders         Order[]

  @@unique([createdBy, clientRequestId])
  @@index([contractNo])
  @@index([status])
  @@index([sellerId])
  @@index([signingPartnerId])
  @@map("contracts")
}

model ContractLineItem {
  id           String    @id @default(cuid())
  contractId   String
  materialId   String
  materialName String?
  quantity     Decimal   @db.Decimal(15, 3)
  unit         String    @default("TON")
  unitPrice    Decimal   @db.Decimal(15, 4)
  totalPrice   Decimal   @db.Decimal(15, 2)
  deliveryDate DateTime?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_line_items")
}

model Order {
  id               String    @id @default(cuid())
  orderNo          String    @unique
  name             String
  contractId       String
  type             String // PURCHASE | SALES
  status           String    @default("DRAFT") // DRAFT | CONFIRMED | DISPATCHED | COMPLETED | CANCELLED
  totalAmount      Decimal   @db.Decimal(15, 2)
  plannedDate      DateTime?
  deliveryLocation String?
  remarks          String?
  dispatchedAt     DateTime?
  completedAt      DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  contract        Contract         @relation(fields: [contractId], references: [id])
  creator         User             @relation("OrderCreator", fields: [createdBy], references: [id])
  lineItems       OrderLineItem[]
  dispatchNotices DispatchNotice[]

  @@index([orderNo])
  @@index([contractId])
  @@index([status])
  @@index([type])
  @@map("orders")
}

model OrderLineItem {
  id                 String   @id @default(cuid())
  orderId            String
  contractLineItemId String
  materialId         String
  materialName       String?
  quantity           Decimal  @db.Decimal(15, 3)
  unit               String   @default("TON")
  unitPrice          Decimal  @db.Decimal(15, 4)
  totalPrice         Decimal  @db.Decimal(15, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order                   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchNoticeLineItems DispatchNoticeLineItem[]

  @@index([orderId])
  @@index([contractLineItemId])
  @@map("order_line_items")
}

// ========== 执行通知与物流 ==========

model DispatchNotice {
  id                  String    @id @default(cuid())
  noticeNo            String    @unique
  orderId             String
  type                String // PURCHASE | SALES
  mode                String    @default("STANDARD") // STANDARD | DIRECT
  status              String    @default("DRAFT") // DRAFT | ISSUED | IN_PROGRESS | COMPLETED | CANCELLED
  warehouseId         String?
  plannedDate         DateTime?
  originLocation      String?
  destinationLocation String?
  totalQuantity       Decimal   @db.Decimal(15, 3)
  remarks             String?
  issuedAt            DateTime?
  completedAt         DateTime?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  order         Order                    @relation(fields: [orderId], references: [id])
  warehouse     Warehouse?               @relation(fields: [warehouseId], references: [id])
  creator       User                     @relation("DispatchNoticeCreator", fields: [createdBy], references: [id])
  lineItems     DispatchNoticeLineItem[]
  waybills      Waybill[]
  outboundOrder OutboundOrder?

  @@index([noticeNo])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([warehouseId])
  @@map("dispatch_notices")
}

model DispatchNoticeLineItem {
  id               String   @id @default(cuid())
  dispatchNoticeId String
  orderLineItemId  String
  materialId       String
  materialName     String?
  quantity         Decimal  @db.Decimal(15, 3)
  unit             String   @default("TON")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dispatchNotice    DispatchNotice     @relation(fields: [dispatchNoticeId], references: [id], onDelete: Cascade)
  orderLineItem     OrderLineItem      @relation(fields: [orderLineItemId], references: [id])
  waybillLineItems  WaybillLineItem[]
  outboundOrderLine OutboundOrderLine?

  @@index([dispatchNoticeId])
  @@index([orderLineItemId])
  @@map("dispatch_notice_line_items")
}

model Waybill {
  id                  String    @id @default(cuid())
  waybillNo           String    @unique
  dispatchNoticeId    String
  status              String    @default("PENDING") // PENDING | IN_TRANSIT | ARRIVED | SIGNED | CANCELLED
  freightMode         String    @default("SELF") // SELF | THIRD_PARTY
  vehicleId           String?
  driverId            String?
  carrierPartnerId    String?
  carrierName         String?
  plateNo             String?
  driverName          String?
  driverPhone         String?
  originLocation      String?
  destinationLocation String?
  totalQuantity       Decimal   @db.Decimal(15, 3)
  plannedDepartureAt  DateTime?
  plannedArrivalAt    DateTime?
  departedAt          DateTime?
  arrivedAt           DateTime?
  signedAt            DateTime?
  remarks             String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  dispatchNotice   DispatchNotice           @relation(fields: [dispatchNoticeId], references: [id])
  vehicle          Vehicle?                 @relation(fields: [vehicleId], references: [id])
  driver           Driver?                  @relation(fields: [driverId], references: [id])
  carrierPartner   Partner?                 @relation("WaybillCarrierPartner", fields: [carrierPartnerId], references: [id])
  creator          User                     @relation("WaybillCreator", fields: [createdBy], references: [id])
  lineItems        WaybillLineItem[]
  weighTickets     WeighTicket[]
  weightSelections WaybillWeightSelection[]
  attachments      Attachment[]
  inboundReceipts  InboundReceipt[]
  outboundReceipts OutboundReceipt[]
  qualityTask      QualityTask?

  @@index([waybillNo])
  @@index([dispatchNoticeId])
  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([carrierPartnerId])
  @@map("waybills")
}

model WaybillLineItem {
  id                       String   @id @default(cuid())
  waybillId                String
  dispatchNoticeLineItemId String
  materialId               String
  materialName             String?
  quantity                 Decimal  @db.Decimal(15, 3)
  unit                     String   @default("TON")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  waybill                Waybill                @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  dispatchNoticeLineItem DispatchNoticeLineItem @relation(fields: [dispatchNoticeLineItemId], references: [id])

  @@index([waybillId])
  @@index([dispatchNoticeLineItemId])
  @@map("waybill_line_items")
}

model WeighTicket {
  id                    String    @id @default(cuid())
  ticketNo              String    @unique
  waybillId             String
  direction             String // INBOUND | OUTBOUND
  weighingStage         String    @default("RECEIVING") // SHIPPING | RECEIVING
  sequence              Int       @default(1)
  isSupplementary       Boolean   @default(false)
  previousTicketId      String?
  additionReason        String?
  status                String    @default("PENDING") // PENDING | WEIGHING | COMPLETED | REVIEWED | VOIDED
  dataSource            String    @default("MANUAL") // DEVICE | MANUAL | IMPORTED
  ticketDate            DateTime  @default(now())
  plateNo               String?
  materialName          String?
  materialSpec          String?
  shipperName           String?
  receiverName          String?
  packageCount          Int?
  driverName            String?
  weighmasterName       String?
  printedAt             DateTime?
  plannedQuantity       Decimal   @db.Decimal(15, 3)
  selectedGrossRecordId String?
  selectedTareRecordId  String?
  grossWeight           Decimal?  @db.Decimal(15, 3)
  tareWeight            Decimal?  @db.Decimal(15, 3)
  netWeight             Decimal?  @db.Decimal(15, 3)
  shippingWeight        Decimal?  @db.Decimal(15, 3)
  receivingWeight       Decimal?  @db.Decimal(15, 3)
  customerWeight        Decimal?  @db.Decimal(15, 3)
  thirdPartyWeight      Decimal?  @db.Decimal(15, 3)
  manualWeight          Decimal?  @db.Decimal(15, 3)
  settlementBasis       String    @default("RECEIVING") // RECEIVING | SHIPPING | CUSTOMER | THIRD_PARTY | MANUAL
  settlementWeight      Decimal?  @db.Decimal(15, 3)
  varianceWeight        Decimal?  @db.Decimal(15, 3)
  varianceRate          Decimal?  @db.Decimal(10, 4)
  toleranceRate         Decimal   @default(0.5) @db.Decimal(10, 4)
  abnormal              Boolean   @default(false)
  remarks               String?
  reviewRemark          String?
  reviewedBy            String?
  reviewedAt            DateTime?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  waybill              Waybill                  @relation(fields: [waybillId], references: [id])
  previousTicket       WeighTicket?             @relation("SupplementaryWeighTickets", fields: [previousTicketId], references: [id])
  supplementaryTickets WeighTicket[]            @relation("SupplementaryWeighTickets")
  creator              User                     @relation("WeighTicketCreator", fields: [createdBy], references: [id])
  reviewer             User?                    @relation("WeighTicketReviewer", fields: [reviewedBy], references: [id])
  records              WeighRecord[]
  attachments          Attachment[]
  qualityInspections   QualityInspection[]
  inboundReceipts      InboundReceipt[]
  outboundReceipts     OutboundReceipt[]
  weightSelections     WaybillWeightSelection[]

  @@index([ticketNo])
  @@index([ticketDate])
  @@index([waybillId])
  @@index([waybillId, weighingStage])
  @@index([previousTicketId])
  @@index([status])
  @@index([abnormal])
  @@map("weigh_tickets")
}

model WaybillWeightSelection {
  id            String   @id @default(cuid())
  waybillId     String
  purpose       String // INVENTORY | SETTLEMENT
  weighTicketId String
  quantity      Decimal  @db.Decimal(15, 3)
  reason        String?
  isCurrent     Boolean  @default(true)
  selectedBy    String
  selectedAt    DateTime @default(now())

  waybill     Waybill     @relation(fields: [waybillId], references: [id])
  weighTicket WeighTicket @relation(fields: [weighTicketId], references: [id])
  selector    User        @relation("WaybillWeightSelector", fields: [selectedBy], references: [id])

  @@index([waybillId, purpose, isCurrent])
  @@index([weighTicketId])
  @@index([selectedBy])
  @@map("waybill_weight_selections")
}

model WeighRecord {
  id            String   @id @default(cuid())
  weighTicketId String
  weighingType  String // GROSS | TARE
  sequence      Int
  weight        Decimal  @db.Decimal(15, 3)
  dataSource    String   @default("MANUAL") // DEVICE | MANUAL | IMPORTED
  weighedAt     DateTime @default(now())
  operatorId    String
  remarks       String?
  createdAt     DateTime @default(now())

  weighTicket WeighTicket @relation(fields: [weighTicketId], references: [id], onDelete: Cascade)
  operator    User        @relation("WeighRecordOperator", fields: [operatorId], references: [id])

  @@unique([weighTicketId, sequence])
  @@index([weighTicketId])
  @@index([weighingType])
  @@map("weigh_records")
}

// ========== 质检化验 ==========

/// 一次物流到货对应一个质检任务，机构检测报告作为任务子记录归集。
model QualityTask {
  id                   String    @id @default(cuid())
  taskNo               String    @unique
  waybillId            String    @unique
  status               String    @default("PENDING_SAMPLING") // PENDING_SAMPLING | INSPECTING | PENDING_DECISION | COMPLETED | RECHECK_REQUIRED | VOIDED
  plannedReportCount   Int       @default(3)
  sampledAt            DateTime?
  samplerName          String?
  samplingMethod       String?
  handlerId            String?
  handledAt            DateTime?
  finalConclusion      String    @default("PENDING") // PENDING | PASS | DEDUCTION | FUSE
  basisInspectionId    String?
  finalizedReportIds   Json?
  finalizedReportCount Int       @default(0)
  decisionReason       String?
  decisionVersion      Int       @default(0)
  decidedBy            String?
  decidedAt            DateTime?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  waybill         Waybill             @relation(fields: [waybillId], references: [id])
  creator         User                @relation("QualityTaskCreator", fields: [createdBy], references: [id])
  handler         User?               @relation("QualityTaskHandler", fields: [handlerId], references: [id])
  decider         User?               @relation("QualityTaskDecider", fields: [decidedBy], references: [id])
  basisInspection QualityInspection?  @relation("QualityTaskBasisInspection", fields: [basisInspectionId], references: [id])
  reports         QualityInspection[] @relation("QualityTaskReports")

  @@index([status])
  @@index([finalConclusion])
  @@index([handlerId])
  @@index([decidedBy])
  @@map("quality_tasks")
}

model QualityInspection {
  id                      String    @id @default(cuid())
  inspectionNo            String    @unique
  qualityTaskId           String
  weighTicketId           String
  status                  String    @default("DRAFT") // DRAFT | TESTING | REPORTED | CONFIRMED | VOIDED
  conclusion              String    @default("PENDING") // PENDING | PASS | DEDUCTION | FUSE
  dataSource              String    @default("MANUAL") // DEVICE | MANUAL | OCR
  institutionType         String    @default("OUR") // OUR | PARTNER | THIRD_PARTY | OTHER
  institutionPartnerId    String?
  institutionName         String
  reportNo                String
  testedAt                DateTime
  sampledAt               DateTime
  samplerName             String
  samplingMethod          String?
  sampleNo                String?
  sampleNo1               String?
  sampleNo2               String?
  sampleNo3               String?
  materialName            String
  materialSpec            String?
  supplierName            String?
  plateNo                 String?
  baseWeight              Decimal?  @db.Decimal(15, 3)
  moistureDeductionWeight Decimal   @default(0) @db.Decimal(15, 3)
  impurityDeductionWeight Decimal   @default(0) @db.Decimal(15, 3)
  settlementWeight        Decimal?  @db.Decimal(15, 3)
  deductionAmount         Decimal   @default(0) @db.Decimal(15, 2)
  fuseReason              String?
  resolution              String?
  resolvedAt              DateTime?
  remarks                 String?
  confirmedBy             String?
  confirmedAt             DateTime?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  qualityTask        QualityTask                  @relation("QualityTaskReports", fields: [qualityTaskId], references: [id])
  basisForTasks      QualityTask[]                @relation("QualityTaskBasisInspection")
  weighTicket        WeighTicket                  @relation(fields: [weighTicketId], references: [id])
  creator            User                         @relation("QualityInspectionCreator", fields: [createdBy], references: [id])
  confirmer          User?                        @relation("QualityInspectionConfirmer", fields: [confirmedBy], references: [id])
  institutionPartner Partner?                     @relation("QualityInstitutionPartner", fields: [institutionPartnerId], references: [id])
  indicators         QualityInspectionIndicator[]
  attachments        Attachment[]
  inboundReceipts    InboundReceipt[]

  @@index([inspectionNo])
  @@index([qualityTaskId])
  @@index([weighTicketId])
  @@index([status])
  @@index([conclusion])
  @@index([institutionType])
  @@index([institutionPartnerId])
  @@index([reportNo])
  @@index([testedAt])
  @@index([sampledAt])
  @@map("quality_inspections")
}

model QualityInspectionIndicator {
  id            String   @id @default(cuid())
  inspectionId  String
  code          String
  name          String
  operator      String // GTE | LTE | EQ | RANGE
  standardValue Decimal? @db.Decimal(15, 4)
  upperValue    Decimal? @db.Decimal(15, 4)
  fuseValue     Decimal? @db.Decimal(15, 4)
  unit          String   @default("%")
  measuredValue Decimal? @db.Decimal(15, 4)
  result        String   @default("PENDING") // PENDING | PASS | FAIL | FUSE
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, code])
  @@index([inspectionId])
  @@map("quality_inspection_indicators")
}

// ========== 入库与库存 ==========

model InboundReceipt {
  id                      String    @id @default(cuid())
  receiptNo               String    @unique
  waybillId               String
  weighTicketId           String?
  qualityInspectionId     String?
  warehouseId             String?
  status                  String    @default("PENDING") // PENDING | RECEIVED | POSTED | CANCELLED
  acceptanceConclusion    String? // PASS；最终验收质检单确认前为空
  materialName            String
  materialSpec            String?
  supplierName            String?
  plateNo                 String?
  plannedQuantity         Decimal   @default(0) @db.Decimal(15, 3)
  receivedQuantity        Decimal?  @db.Decimal(15, 3)
  moistureDeductionWeight Decimal   @default(0) @db.Decimal(15, 3)
  impurityDeductionWeight Decimal   @default(0) @db.Decimal(15, 3)
  deductionAmount         Decimal   @default(0) @db.Decimal(15, 2)
  receivedAt              DateTime?
  receiverName            String?
  remarks                 String?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  waybill           Waybill            @relation(fields: [waybillId], references: [id])
  weighTicket       WeighTicket?       @relation(fields: [weighTicketId], references: [id])
  qualityInspection QualityInspection? @relation(fields: [qualityInspectionId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  creator           User               @relation("InboundReceiptCreator", fields: [createdBy], references: [id])
  businessInbound   BusinessInbound?
  attachments       Attachment[]

  @@index([receiptNo])
  @@index([waybillId])
  @@index([weighTicketId])
  @@index([qualityInspectionId])
  @@index([warehouseId])
  @@index([status])
  @@map("inbound_receipts")
}

model BusinessInbound {
  id             String   @id @default(cuid())
  inboundNo      String   @unique
  receiptId      String   @unique
  warehouseId    String
  ownerPartnerId String?
  materialId     String
  materialName   String
  supplierName   String?
  quantity       Decimal  @db.Decimal(15, 3)
  status         String   @default("POSTED") // POSTED | PARTIALLY_REVERSED | REVERSED | CANCELLED
  lotNo          String
  postedAt       DateTime @default(now())
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receipt        InboundReceipt      @relation(fields: [receiptId], references: [id])
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  inventoryOwner Partner?            @relation("BusinessInboundOwner", fields: [ownerPartnerId], references: [id])
  material       Material            @relation(fields: [materialId], references: [id])
  creator        User                @relation("BusinessInboundCreator", fields: [createdBy], references: [id])
  inventoryLot   InventoryLot?
  reversals      InventoryReversal[]

  @@index([inboundNo])
  @@index([warehouseId])
  @@index([ownerPartnerId])
  @@index([materialId])
  @@index([status])
  @@map("business_inbounds")
}

model InventoryLot {
  id                     String   @id @default(cuid())
  lotNo                  String   @unique
  businessInboundId      String?  @unique
  productionCompletionId String?  @unique
  warehouseId            String
  ownerPartnerId         String?
  materialId             String
  materialName           String
  supplierName           String?
  initialQuantity        Decimal  @db.Decimal(15, 3)
  availableQuantity      Decimal  @db.Decimal(15, 3)
  qualityConclusion      String
  status                 String   @default("AVAILABLE") // AVAILABLE | DEPLETED | LOCKED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  businessInbound       BusinessInbound?               @relation(fields: [businessInboundId], references: [id])
  productionCompletion  ProductionCompletion?          @relation(fields: [productionCompletionId], references: [id])
  warehouse             Warehouse                      @relation(fields: [warehouseId], references: [id])
  inventoryOwner        Partner?                       @relation("InventoryLotOwner", fields: [ownerPartnerId], references: [id])
  material              Material                       @relation(fields: [materialId], references: [id])
  ledgers               InventoryLedger[]
  outboundAllocations   OutboundReceiptAllocation[]
  salesOutboundLines    SalesOutboundLine[]
  reversalLines         InventoryReversalLine[]
  productionAllocations ProductionMaterialAllocation[]

  @@index([warehouseId])
  @@index([ownerPartnerId])
  @@index([materialId])
  @@index([status])
  @@map("inventory_lots")
}

model InventoryLedger {
  id             String   @id @default(cuid())
  lotId          String
  warehouseId    String
  materialId     String
  businessType   String // INBOUND | OUTBOUND | ADJUSTMENT
  businessNo     String
  quantityChange Decimal  @db.Decimal(15, 3)
  balanceAfter   Decimal  @db.Decimal(15, 3)
  remarks        String?
  createdBy      String
  createdAt      DateTime @default(now())

  lot       InventoryLot @relation(fields: [lotId], references: [id])
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  material  Material     @relation(fields: [materialId], references: [id])
  creator   User         @relation("InventoryLedgerCreator", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([warehouseId])
  @@index([materialId])
  @@index([businessType])
  @@map("inventory_ledgers")
}

// ========== 生产管理 ==========

/// 可复用的生产方案；定义一个主产出物料及其标准投入配比。
model ProductionRecipe {
  id                  String    @id @default(cuid())
  recipeNo            String    @unique
  name                String
  ownerPartnerId      String
  outputMaterialId    String
  baseOutputQuantity  Decimal   @default(1) @db.Decimal(15, 3)
  expectedYieldRate   Decimal?  @db.Decimal(10, 4)
  lossToleranceRate   Decimal   @default(5) @db.Decimal(10, 4)
  qualityRequired     Boolean   @default(true)
  processDescription  String?
  qualityRequirements String?
  status              String    @default("ACTIVE") // ACTIVE | INACTIVE
  remark              String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  ownerPartner   Partner                 @relation("ProductionRecipeOwner", fields: [ownerPartnerId], references: [id])
  outputMaterial Material                @relation("ProductionRecipeOutputMaterial", fields: [outputMaterialId], references: [id])
  creator        User                    @relation("ProductionRecipeCreator", fields: [createdBy], references: [id])
  inputs         ProductionRecipeInput[]
  tasks          ProductionTask[]

  @@index([ownerPartnerId])
  @@index([outputMaterialId])
  @@index([status])
  @@map("production_recipes")
}

model ProductionRecipeInput {
  id           String   @id @default(cuid())
  recipeId     String
  materialId   String
  materialRole String   @default("RAW") // RAW | AUXILIARY | PACKAGING
  quantity     Decimal  @db.Decimal(15, 3) // 每 baseOutputQuantity 产出所需投入量
  unit         String   @default("TON")
  sort         Int      @default(0)
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe   ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material         @relation(fields: [materialId], references: [id])

  @@unique([recipeId, materialId])
  @@index([materialId])
  @@map("production_recipe_inputs")
}

/// 自营生产与委外加工共用的任务主单。
model ProductionTask {
  id                      String    @id @default(cuid())
  taskNo                  String    @unique
  name                    String
  mode                    String    @default("INTERNAL") // INTERNAL | OUTSOURCED
  status                  String    @default("DRAFT") // DRAFT | RELEASED | MATERIAL_PREPARED | IN_PROGRESS | PENDING_QC | PARTIAL_COMPLETED | COMPLETED | CLOSED | CANCELLED
  recipeId                String
  ownerPartnerId          String
  processorOrganizationId String?
  sourceWarehouseId       String
  targetWarehouseId       String
  outputMaterialId        String
  sourceType              String    @default("MANUAL") // MANUAL | SALES_ORDER
  sourceOrderId           String?
  sourceOrderNo           String?
  plannedOutputQuantity   Decimal   @db.Decimal(15, 3)
  completedQuantity       Decimal   @default(0) @db.Decimal(15, 3)
  qualifiedQuantity       Decimal   @default(0) @db.Decimal(15, 3)
  actualYieldRate         Decimal?  @db.Decimal(10, 4)
  lossToleranceRate       Decimal   @default(5) @db.Decimal(10, 4)
  qualityRequired         Boolean   @default(true)
  processingFeeRate       Decimal?  @db.Decimal(15, 2)
  operatorName            String?
  plannedStartAt          DateTime?
  plannedEndAt            DateTime?
  releasedAt              DateTime?
  actualStartAt           DateTime?
  actualEndAt             DateTime?
  remarks                 String?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  recipe                ProductionRecipe       @relation(fields: [recipeId], references: [id])
  ownerPartner          Partner                @relation("ProductionTaskOwner", fields: [ownerPartnerId], references: [id])
  processorOrganization ServiceOrganization?   @relation(fields: [processorOrganizationId], references: [id])
  sourceWarehouse       Warehouse              @relation("ProductionTaskSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse       Warehouse              @relation("ProductionTaskTargetWarehouse", fields: [targetWarehouseId], references: [id])
  outputMaterial        Material               @relation("ProductionTaskOutputMaterial", fields: [outputMaterialId], references: [id])
  creator               User                   @relation("ProductionTaskCreator", fields: [createdBy], references: [id])
  inputs                ProductionTaskInput[]
  completions           ProductionCompletion[]

  @@index([status])
  @@index([mode])
  @@index([recipeId])
  @@index([ownerPartnerId])
  @@index([processorOrganizationId])
  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([outputMaterialId])
  @@index([sourceOrderId])
  @@map("production_tasks")
}

model ProductionTaskInput {
  id               String   @id @default(cuid())
  taskId           String
  materialId       String
  materialRole     String   @default("RAW")
  plannedQuantity  Decimal  @db.Decimal(15, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  issuedQuantity   Decimal  @default(0) @db.Decimal(15, 3)
  consumedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  returnedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  unit             String   @default("TON")
  sort             Int      @default(0)
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  task        ProductionTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  material    Material                       @relation(fields: [materialId], references: [id])
  allocations ProductionMaterialAllocation[]

  @@unique([taskId, materialId])
  @@index([materialId])
  @@map("production_task_inputs")
}

/// 指定原料批次的预占、领用、耗用和退料累计值，是批次追溯的核心。
model ProductionMaterialAllocation {
  id               String   @id @default(cuid())
  taskInputId      String
  inventoryLotId   String
  reservedQuantity Decimal  @db.Decimal(15, 3)
  issuedQuantity   Decimal  @default(0) @db.Decimal(15, 3)
  consumedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  returnedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  taskInput    ProductionTaskInput @relation(fields: [taskInputId], references: [id], onDelete: Cascade)
  inventoryLot InventoryLot        @relation(fields: [inventoryLotId], references: [id])

  @@unique([taskInputId, inventoryLotId])
  @@index([inventoryLotId])
  @@map("production_material_allocations")
}

/// 每次完工申报形成一条独立记录；合格并过账后对应一个产成品库存批次。
model ProductionCompletion {
  id                 String    @id @default(cuid())
  completionNo       String    @unique
  taskId             String
  materialId         String
  quantity           Decimal   @db.Decimal(15, 3)
  status             String    @default("PENDING_QC") // PENDING_QC | READY_TO_POST | REWORK | SCRAPPED | POSTED
  qualityConclusion  String    @default("PENDING") // PENDING | PASS | REWORK | SCRAP
  qualityRemark      String?
  producedAt         DateTime  @default(now())
  qualityConfirmedBy String?
  qualityConfirmedAt DateTime?
  postedBy           String?
  postedAt           DateTime?
  remarks            String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  task             ProductionTask @relation(fields: [taskId], references: [id])
  material         Material       @relation(fields: [materialId], references: [id])
  creator          User           @relation("ProductionCompletionCreator", fields: [createdBy], references: [id])
  qualityConfirmer User?          @relation("ProductionCompletionQualityConfirmer", fields: [qualityConfirmedBy], references: [id])
  poster           User?          @relation("ProductionCompletionPoster", fields: [postedBy], references: [id])
  inventoryLot     InventoryLot?

  @@index([taskId])
  @@index([materialId])
  @@index([status])
  @@index([qualityConclusion])
  @@map("production_completions")
}

// ========== 销售出库与库存扣减 ==========

model OutboundOrder {
  id               String   @id @default(cuid())
  orderNo          String   @unique
  dispatchNoticeId String   @unique
  warehouseId      String?
  ownerPartnerId   String?
  status           String   @default("PENDING") // PENDING | PARTIAL | COMPLETED | CANCELLED
  plannedQuantity  Decimal  @db.Decimal(15, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  actualQuantity   Decimal  @default(0) @db.Decimal(15, 3)
  shortageQuantity Decimal  @default(0) @db.Decimal(15, 3)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dispatchNotice DispatchNotice      @relation(fields: [dispatchNoticeId], references: [id])
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  inventoryOwner Partner?            @relation("OutboundOrderOwner", fields: [ownerPartnerId], references: [id])
  creator        User                @relation("OutboundOrderCreator", fields: [createdBy], references: [id])
  lineItems      OutboundOrderLine[]
  receipts       OutboundReceipt[]

  @@index([orderNo])
  @@index([warehouseId])
  @@index([ownerPartnerId])
  @@index([status])
  @@map("outbound_orders")
}

model OutboundOrderLine {
  id                       String   @id @default(cuid())
  outboundOrderId          String
  dispatchNoticeLineItemId String   @unique
  materialId               String
  materialName             String?
  unit                     String   @default("TON")
  plannedQuantity          Decimal  @db.Decimal(15, 3)
  reservedQuantity         Decimal  @default(0) @db.Decimal(15, 3)
  actualQuantity           Decimal  @default(0) @db.Decimal(15, 3)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  outboundOrder          OutboundOrder          @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)
  dispatchNoticeLineItem DispatchNoticeLineItem @relation(fields: [dispatchNoticeLineItemId], references: [id])

  @@index([outboundOrderId])
  @@index([materialId])
  @@map("outbound_order_lines")
}

model OutboundReceipt {
  id                 String    @id @default(cuid())
  receiptNo          String    @unique
  outboundOrderId    String
  waybillId          String
  weighTicketId      String?
  warehouseId        String
  status             String    @default("PENDING") // PENDING | READY | VARIANCE_PENDING | POSTED | CANCELLED
  materialId         String
  materialName       String
  customerName       String?
  plateNo            String?
  plannedQuantity    Decimal   @db.Decimal(15, 3)
  outboundQuantity   Decimal?  @db.Decimal(15, 3)
  varianceQuantity   Decimal?  @db.Decimal(15, 3)
  varianceRate       Decimal?  @db.Decimal(10, 4)
  varianceDecision   String? // SHORT_CONTINUE | SHORT_CLOSE | OVERAGE_APPROVED
  varianceReason     String?
  varianceResolvedBy String?
  varianceResolvedAt DateTime?
  departedAt         DateTime?
  operatorName       String?
  remarks            String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  outboundOrder OutboundOrder               @relation(fields: [outboundOrderId], references: [id])
  waybill       Waybill                     @relation(fields: [waybillId], references: [id])
  weighTicket   WeighTicket?                @relation(fields: [weighTicketId], references: [id])
  warehouse     Warehouse                   @relation(fields: [warehouseId], references: [id])
  material      Material                    @relation(fields: [materialId], references: [id])
  creator       User                        @relation("OutboundReceiptCreator", fields: [createdBy], references: [id])
  allocations   OutboundReceiptAllocation[]
  salesOutbound SalesOutbound?
  attachments   Attachment[]

  @@index([receiptNo])
  @@index([outboundOrderId])
  @@index([waybillId])
  @@index([weighTicketId])
  @@index([warehouseId])
  @@index([materialId])
  @@index([status])
  @@map("outbound_receipts")
}

model OutboundReceiptAllocation {
  id                String   @id @default(cuid())
  outboundReceiptId String
  inventoryLotId    String
  quantity          Decimal  @db.Decimal(15, 3)
  createdAt         DateTime @default(now())

  outboundReceipt OutboundReceipt @relation(fields: [outboundReceiptId], references: [id], onDelete: Cascade)
  inventoryLot    InventoryLot    @relation(fields: [inventoryLotId], references: [id])

  @@unique([outboundReceiptId, inventoryLotId])
  @@index([inventoryLotId])
  @@map("outbound_receipt_allocations")
}

model SalesOutbound {
  id           String   @id @default(cuid())
  outboundNo   String   @unique
  receiptId    String   @unique
  warehouseId  String
  materialId   String
  materialName String
  customerName String?
  quantity     Decimal  @db.Decimal(15, 3)
  status       String   @default("POSTED") // POSTED | PARTIALLY_REVERSED | REVERSED | CANCELLED
  postedAt     DateTime @default(now())
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receipt   OutboundReceipt     @relation(fields: [receiptId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  material  Material            @relation(fields: [materialId], references: [id])
  creator   User                @relation("SalesOutboundCreator", fields: [createdBy], references: [id])
  lines     SalesOutboundLine[]
  reversals InventoryReversal[]

  @@index([outboundNo])
  @@index([warehouseId])
  @@index([materialId])
  @@index([status])
  @@map("sales_outbounds")
}

model SalesOutboundLine {
  id              String   @id @default(cuid())
  salesOutboundId String
  inventoryLotId  String
  quantity        Decimal  @db.Decimal(15, 3)
  balanceAfter    Decimal  @db.Decimal(15, 3)
  createdAt       DateTime @default(now())

  salesOutbound SalesOutbound           @relation(fields: [salesOutboundId], references: [id], onDelete: Cascade)
  inventoryLot  InventoryLot            @relation(fields: [inventoryLotId], references: [id])
  reversalLines InventoryReversalLine[]

  @@unique([salesOutboundId, inventoryLotId])
  @@index([inventoryLotId])
  @@map("sales_outbound_lines")
}

// ========== 库存冲销 ==========

model InventoryReversal {
  id                String    @id @default(cuid())
  reversalNo        String    @unique
  type              String // INBOUND | OUTBOUND
  status            String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | POSTED | CANCELLED
  businessInboundId String?
  salesOutboundId   String?
  reason            String
  remarks           String?
  submittedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  approvalComment   String?
  rejectedReason    String?
  postedBy          String?
  postedAt          DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  businessInbound BusinessInbound?        @relation(fields: [businessInboundId], references: [id])
  salesOutbound   SalesOutbound?          @relation(fields: [salesOutboundId], references: [id])
  creator         User                    @relation("InventoryReversalCreator", fields: [createdBy], references: [id])
  approver        User?                   @relation("InventoryReversalApprover", fields: [approvedBy], references: [id])
  poster          User?                   @relation("InventoryReversalPoster", fields: [postedBy], references: [id])
  lines           InventoryReversalLine[]
  attachments     Attachment[]

  @@index([reversalNo])
  @@index([type])
  @@index([status])
  @@index([businessInboundId])
  @@index([salesOutboundId])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([postedBy])
  @@map("inventory_reversals")
}

model InventoryReversalLine {
  id                        String   @id @default(cuid())
  reversalId                String
  inventoryLotId            String
  sourceSalesOutboundLineId String?
  sourceQuantity            Decimal  @db.Decimal(15, 3)
  quantity                  Decimal  @db.Decimal(15, 3)
  balanceAfter              Decimal? @db.Decimal(15, 3)
  createdAt                 DateTime @default(now())

  reversal                InventoryReversal  @relation(fields: [reversalId], references: [id], onDelete: Cascade)
  inventoryLot            InventoryLot       @relation(fields: [inventoryLotId], references: [id])
  sourceSalesOutboundLine SalesOutboundLine? @relation(fields: [sourceSalesOutboundLineId], references: [id])

  @@unique([reversalId, inventoryLotId])
  @@index([inventoryLotId])
  @@index([sourceSalesOutboundLineId])
  @@map("inventory_reversal_lines")
}

model Approval {
  id           String    @id @default(cuid())
  contractId   String
  assigneeId   String
  actedById    String?
  nodeName     String    @default("合同审批")
  roleCode     String?
  roleName     String?
  approvalMode String    @default("ALL") // ALL | ANY
  step         Int       @default(1)
  round        Int       @default(1)
  status       String    @default("WAITING") // WAITING | PENDING | APPROVED | REJECTED | OTHERS_APPROVED | OTHERS_REJECTED | CANCELLED
  comment      String?
  actedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  assignee User     @relation("ApprovalAssignee", fields: [assigneeId], references: [id])
  actedBy  User?    @relation("ApprovalActor", fields: [actedById], references: [id])

  @@index([contractId])
  @@index([assigneeId])
  @@index([actedById])
  @@index([contractId, round, step])
  @@map("approvals")
}

model ApprovalFlow {
  id              String   @id @default(cuid())
  name            String
  contractType    String   @unique
  amountThreshold Decimal? @db.Decimal(15, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nodes ApprovalFlowNode[]

  @@map("approval_flows")
}

model ApprovalFlowNode {
  id           String   @id @default(cuid())
  flowId       String
  nodeName     String
  step         Int
  roleId       String
  approvalMode String   @default("ALL") // ALL（会签）| ANY（或签）
  scopeType    String   @default("COMPANY") // DEPARTMENT | COMPANY | ALL
  condition    String   @default("ALWAYS") // ALWAYS | AMOUNT_GTE_THRESHOLD
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flow ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([flowId, step])
  @@index([roleId])
  @@map("approval_flow_nodes")
}

/// 附件/影像
model Attachment {
  id                  String   @id @default(cuid())
  partnerId           String? // 关联合作伙伴
  contractId          String? // 关联合同
  waybillId           String? // 关联物流运单
  weighTicketId       String? // 关联磅单
  qualityInspectionId String? // 关联质检单
  inboundReceiptId    String? // 关联物流入库单
  outboundReceiptId   String? // 关联物流出库单
  inventoryReversalId String? // 关联库存冲销单
  fileName            String // 存储文件名（UUID）
  originalName        String // 原始文件名
  mimeType            String
  size                Int // 字节
  category            String // 附件类别
  createdAt           DateTime @default(now())

  partner           Partner?           @relation(fields: [partnerId], references: [id])
  contract          Contract?          @relation(fields: [contractId], references: [id])
  waybill           Waybill?           @relation(fields: [waybillId], references: [id])
  weighTicket       WeighTicket?       @relation(fields: [weighTicketId], references: [id])
  qualityInspection QualityInspection? @relation(fields: [qualityInspectionId], references: [id])
  inboundReceipt    InboundReceipt?    @relation(fields: [inboundReceiptId], references: [id])
  outboundReceipt   OutboundReceipt?   @relation(fields: [outboundReceiptId], references: [id])
  inventoryReversal InventoryReversal? @relation(fields: [inventoryReversalId], references: [id])

  @@index([partnerId])
  @@index([contractId])
  @@index([waybillId])
  @@index([weighTicketId])
  @@index([qualityInspectionId])
  @@index([inboundReceiptId])
  @@index([outboundReceiptId])
  @@index([inventoryReversalId])
  @@map("attachments")
}

// ========== 内容运营中心 ==========

/// 资讯栏目。legacyId 用于迁移旧官网数字主键及保持历史链接有效。
model ContentCategory {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  code      String   @unique
  name      String
  sort      Int      @default(0)
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ContentArticle[]

  @@index([status, sort])
  @@map("content_categories")
}

/// 统一承载行业资讯及平台维护的供应/需求信息。
model ContentArticle {
  id             String   @id @default(cuid())
  legacyId       String?  @unique
  categoryId     String?
  type           String   @default("NEWS") // NEWS | SUPPLY | DEMAND
  title          String
  summary        String?
  content        String   @default("")
  coverUrl       String?
  source         String?
  sourceHash     String?
  author         String?
  tags           String[] @default([])
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | OFFLINE
  publishAt      DateTime?
  publishedById  String?
  createdById    String?
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  productName    String?
  spec           String?
  quantity       String?
  priceText      String?
  region         String?
  deliveryMethod String?
  requirements   String?
  company        String?
  contactName    String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assets   ContentAsset[]

  @@index([type, status, publishAt])
  @@index([categoryId, status])
  @@index([createdAt])
  @@map("content_articles")
}

model ContentProductType {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  code      String   @unique
  name      String
  spec      String?
  unit      String   @default("元/吨")
  sort      Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices ContentProductPrice[]

  @@index([status, sort])
  @@map("content_product_types")
}

model ContentProductPrice {
  id            String   @id @default(cuid())
  legacyId      String?  @unique
  productTypeId String
  businessDate  DateTime @db.Date
  region        String
  marketName    String?
  spec          String?
  price         Decimal  @db.Decimal(15, 4)
  unit          String   @default("元/吨")
  changeAmount  Decimal? @db.Decimal(15, 4)
  source        String   @default("MANUAL") // MANUAL | BAIINFO | IMPORT
  remark        String?
  rawData       Json?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productType ContentProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)

  @@unique([productTypeId, businessDate, region, source, marketName])
  @@index([businessDate, region])
  @@index([productTypeId, businessDate])
  @@map("content_product_prices")
}

model WebsiteContact {
  id           String   @id @default(cuid())
  legacyId     String?  @unique
  name         String
  phone        String
  company      String?
  email        String?
  message      String
  sourcePage   String?
  sourceIp     String?
  status       String   @default("NEW") // NEW | FOLLOWING | COMPLETED | INVALID
  assigneeId   String?
  followUpNote String?
  handledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@map("website_contacts")
}

model SupplyDemandPost {
  id           String   @id @default(cuid())
  legacyId     String?  @unique
  type         String // SUPPLY | DEMAND
  productName  String
  spec         String?
  quantity     String?
  priceText    String?
  region       String?
  description  String?
  contactName  String
  contactPhone String
  company      String?
  wechatOpenId String?
  status       String   @default("PENDING") // PENDING | PUBLISHED | REJECTED | OFFLINE
  rejectReason String?
  source       String   @default("USER") // USER | PLATFORM | MIGRATION
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status, publishedAt])
  @@index([wechatOpenId, createdAt])
  @@map("supply_demand_posts")
}

model ContentAsset {
  id           String   @id @default(cuid())
  articleId    String?
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int
  purpose      String   @default("ATTACHMENT") // COVER | INLINE | ATTACHMENT | DATASET
  createdById  String?
  createdAt    DateTime @default(now())

  article ContentArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, purpose])
  @@map("content_assets")
}

model ContentDataSource {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String // MANUAL | BAIINFO | API | EXCEL
  status        String   @default("ACTIVE")
  schedule      String?
  config        Json?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs ContentJob[]

  @@index([status, type])
  @@map("content_data_sources")
}

model ContentJob {
  id           String   @id @default(cuid())
  sourceId     String?
  type         String // NEWS_SYNC | AI_CLEAN | MARKET_SYNC | DATA_IMPORT
  businessKey  String   @unique
  status       String   @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED | CANCELLED
  payload      Json?
  result       Json?
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  scheduledAt  DateTime @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  nextRetryAt  DateTime?
  errorMessage String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source ContentDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([sourceId, createdAt])
  @@map("content_jobs")
}

model WechatIdentity {
  id        String   @id @default(cuid())
  openId    String   @unique
  unionId   String?
  status    String   @default("ACTIVE")
  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unionId])
  @@map("wechat_identities")
}
